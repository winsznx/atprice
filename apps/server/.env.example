# Required by every process
ATPRICE_NETWORK=chipnet
DATABASE_URL=postgres://mac@/atprice_chipnet?host=/tmp

# API process
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# "none", a hop count, or a comma-separated list of proxy IPs/CIDRs (Compose: the Caddy container's address)
TRUST_PROXY=none
HEALTH_EVAL_INTERVAL_MS=30000

# Keeper and API (health thresholds use the sweep interval)
KEEPER_SWEEP_INTERVAL_MS=30000

# Optional: comma-separated host:port TLS Electrum servers, replacing the built-in list for the network.
# At least two distinct hosts: the health evaluator must read a server the keeper is not reading.
# ELECTRUM_SERVERS=chipnet.imaginary.cash:50002,chipnet.bch.ninja:50002

# Optional: deployment cohort recorded on analytics events (developer_test, pilot, production)
ATPRICE_COHORT=developer_test
LOG_LEVEL=info
