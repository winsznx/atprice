# Required. "mainnet" or "chipnet"; must match the API's ATPRICE_NETWORK.
NEXT_PUBLIC_ATPRICE_NETWORK=
# Required. Origin of the AtPrice API (https; http only for localhost). The client appends /api/v1.
NEXT_PUBLIC_API_URL=
# Optional. Defaults to VERCEL_GIT_COMMIT_SHA or the local git commit.
NEXT_PUBLIC_BUILD_SHA=
# BLAZE banner (DD 7.14). Leave empty to render "not yet published"; an invalid value fails the build.
NEXT_PUBLIC_BLAZE_DECK_URL=
NEXT_PUBLIC_SOURCE_REPO_URL=
# Mainnet token-aware CashAddress (bitcoincash:z...). Provided by Tim only.
NEXT_PUBLIC_EMBER_ADDRESS=
