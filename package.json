{
  "name": "atprice",
  "private": true,
  "type": "module",
  "description": "Non-custodial limit orders for Bitcoin Cash, filled through Cauldron pools by an on-chain covenant",
  "license": "MIT",
  "homepage": "https://atprice.cash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/atprice.git"
  },
  "bugs": {
    "url": "https://github.com/winsznx/atprice/issues"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "cashtokens",
    "cashscript",
    "covenant",
    "limit-orders",
    "cauldron",
    "non-custodial"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && pnpm --filter ./apps/web --filter ./apps/recover run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "recover": "pnpm --filter @atprice/recover recover",
    "screens": "pnpm --filter @atprice/e2e screens",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
