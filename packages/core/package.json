{
  "name": "@atprice/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Isomorphic AtPrice domain logic: order params, record codec, quote maths, transaction builders",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@atprice/contracts": "workspace:*",
    "@bitauth/libauth": "3.1.0-next.8",
    "cashscript": "0.14.0"
  },
  "devDependencies": {
    "@cashlab/cauldron": "1.0.3",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
