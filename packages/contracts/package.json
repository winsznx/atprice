{
  "name": "@atprice/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AtPrice order covenants (CashScript sources and compiled artifacts)",
  "license": "MIT",
  "homepage": "https://github.com/winsznx/atprice/tree/main/packages/contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/atprice.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/winsznx/atprice/issues"
  },
  "keywords": [
    "bitcoin-cash",
    "cashscript",
    "covenant",
    "limit-order",
    "cauldron"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifacts/*.json": "./artifacts/*.json"
  },
  "files": [
    "dist",
    "artifacts",
    "src"
  ],
  "scripts": {
    "compile": "tsx scripts/compile.ts",
    "build": "pnpm run compile && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@cashlab/cauldron": "1.0.3",
    "@cashscript/utils": "0.14.0",
    "@types/node": "26.6.6",
    "cashc": "0.14.0",
    "cashscript": "0.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
